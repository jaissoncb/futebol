{
  "name": "@sabara/futebol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev:api": "node --experimental-strip-types api/dev.ts",
    "dev:g3": "node --experimental-strip-types api/g3-dev.ts",
    "dev:frontend": "vite --mode futebol-dev --host localhost --port 5173 --strictPort",
    "dev:diagnostics": "vite --mode kinde-dev --host localhost --port 5173 --strictPort",
    "test:api": "node --experimental-strip-types --test api/tests/*.test.ts",
    "test:database": "node --experimental-strip-types --test scripts/test-dev-database.ts",
    "dev": "vite --mode futebol-dev --host localhost --port 5173 --strictPort",
    "build:dev": "tsc -b && vite build --mode futebol-dev --outDir dist-dev && node scripts/verify-build.mjs --dev",
    "preview:dev": "vite preview --mode futebol-dev --outDir dist-dev --host localhost --port 5173 --strictPort",
    "build:diagnostics": "tsc -b && vite build --mode kinde-dev --outDir dist-diagnostics",
    "build": "tsc -b && vite build && node scripts/verify-build.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bundle-security": "node --test scripts/test-bundle-security.mjs",
    "test:workflow": "node --test scripts/release-workflow.node.mjs scripts/verify-pages-artifact.node.mjs",
    "test:release-build": "node scripts/test-release-build.mjs",
    "verify:artifact": "node scripts/verify-pages-artifact.mjs dist",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@kinde-oss/kinde-auth-react": "5.13.1",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.11.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0",
    "workbox-window": "7.4.1"
  }
}
